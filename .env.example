# --- Database ---
# Render provides this automatically when you attach a PostgreSQL instance.
# For local dev, point it at your local Postgres:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# --- Security ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=NRyd37kdzxfpq-7Nh_EQMy91OrUf4rbLMUfFHUTfZyF7sXpdP8NKunhmhZKuYGO_
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- App ---
PROJECT_NAME=LeftoverLab
ENVIRONMENT=development
# Comma-separated list of allowed CORS origins ("*" allows all)
BACKEND_CORS_ORIGINS=*

# --- Uploads ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
